<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="JustExtraLight.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:applicationModel="using:Windows.ApplicationModel"
      xmlns:storage="using:Windows.Storage"
      xmlns:viewmodels="using:JustExtraLight.ViewModels"
      mc:Ignorable="d"
      Loaded="Page_Loaded"
      SizeChanged="Page_SizeChanged">

    <Page.DataContext>

        <viewmodels:MainPageViewModel x:Name="viewModel" />

    </Page.DataContext>

    <Grid>

        <VisualStateManager.VisualStateGroups>

            <VisualStateGroup>

                <VisualState x:Name="DefaultState" />

                <VisualState x:Name="WideState">

                    <VisualState.Setters>

                        <Setter Target="AppTitleBar.IsPaneToggleButtonVisible"
                                Value="False" />
                        <Setter Target="MainView.DisplayMode"
                                Value="Inline"/>
                        <Setter Target="MainView.IsPaneOpen"
                                Value="True"/>

                    </VisualState.Setters>
                    
                </VisualState>
                
            </VisualStateGroup>
            
        </VisualStateManager.VisualStateGroups>

        <Grid.Resources>

            <Style BasedOn="{StaticResource AccentButtonStyle}"
                   x:Key="LocalButtonStyle"
                   TargetType="Button">

                <Setter Property="Height"
                        Value="50" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />

            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <TitleBar Background="{ThemeResource ControlFillColorDefaultBrush}"
                  Grid.Row="0"
                  Height="48"
                  IsPaneToggleButtonVisible="True"
                  x:Name="AppTitleBar"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested"
                  Subtitle="BETA"
                  Title="Just eXtra Light">

            <TitleBar.IconSource>

                <ImageIconSource ImageSource="/Assets/Icons/JXLIco.ico" />

            </TitleBar.IconSource>

            <TitleBar.RightHeader>

                <Button Content="&#xE946;"
                        FontFamily="Segoe Fluent Icons">

                    <Button.Flyout>

                        <Flyout>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <Image Grid.Column="0"
                                       Grid.Row="0"
                                       Grid.RowSpan="2"
                                       Height="60"
                                       Margin="0,0,20,0"
                                       Width="60">

                                    <Image.Source>

                                        <BitmapImage DecodePixelHeight="60"
                                                     DecodePixelType="Logical"
                                                     DecodePixelWidth="60"
                                                     UriSource="/Assets/Icons/JXLIco.ico" />

                                    </Image.Source>

                                </Image>

                                <TextBlock Grid.Column="1"
                                           Grid.Row="0"
                                           Grid.RowSpan="2"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    
                                    <Run FontWeight="SemiBold"
                                         x:Name="AppVersionRun" />
                                    
                                    <LineBreak />
                                    
                                    <Run x:Uid="AppMadeWith" />
                                    
                                    <Hyperlink NavigateUri="https://github.com/libjxl/libjxl">
                                        
                                        <Hyperlink.Inlines>
                                            
                                            <Run Text="libjxl" />
                                            
                                        </Hyperlink.Inlines>
                                        
                                    </Hyperlink>
                                    
                                    <Run FontSize="12"
                                         Text="(ver 0.12.0)" />

                                </TextBlock>

                            </Grid>

                        </Flyout>

                    </Button.Flyout>

                </Button>

            </TitleBar.RightHeader>

        </TitleBar>

        <SplitView DisplayMode="Overlay"
                   Grid.Row="1"
                   IsPaneOpen="False"
                   x:Name="MainView"
                   OpenPaneLength="400">

            <SplitView.Content>

                <Grid Padding="36">

                    <TextBlock HorizontalAlignment="Center"
                               x:Name="DragAndDropText"
                               Style="{StaticResource TitleTextBlockStyle}"
                               TextAlignment="Center"
                               x:Uid="DragAndDropInstructions"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind viewModel.ShowListText, Mode=OneWay}" />

                    <ItemsView AllowDrop="True"
                               Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                               DragOver="{x:Bind viewModel.ImageItemsView_DragOver}"
                               Drop="{x:Bind viewModel.ImageItemsView_Drop}"
                               ItemsSource="{x:Bind viewModel.ImagesList}"
                               Margin="0,8,0,0"
                               x:Name="ImageItemsView"
                               SelectionMode="None">

                        <ItemsView.ItemTemplate>

                            <DataTemplate x:DataType="viewmodels:ImageInfoViewModel">

                                <ItemContainer ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay, TargetNullValue=}">

                                    <Grid BorderBrush="{x:Bind BorderColor, Mode=OneWay}"
                                          BorderThickness="2"
                                          CornerRadius="{StaticResource ControlCornerRadius}">

                                        <Image Height="72"
                                               Width="72">

                                            <Image.Source>

                                                <BitmapImage DecodePixelHeight="72"
                                                             DecodePixelType="Logical"
                                                             DecodePixelWidth="72"
                                                             UriSource="{x:Bind TemporaryPath}" />

                                            </Image.Source>

                                        </Image>

                                        <Border Background="{x:Bind BorderColor, Mode=OneWay}"
                                                CornerRadius="50"
                                                Height="24"
                                                HorizontalAlignment="Right"
                                                x:Load="{x:Bind IsConversionCompleted, Mode=OneWay}"
                                                x:Name="SuccessfulBorder"
                                                Padding="4"
                                                VerticalAlignment="Bottom"
                                                Width="24">

                                            <FontIcon FontSize="16"
                                                      Foreground="White"
                                                      Glyph="{x:Bind Icon, Mode=OneWay}" />

                                        </Border>

                                    </Grid>

                                </ItemContainer>

                            </DataTemplate>

                        </ItemsView.ItemTemplate>

                        <ItemsView.Layout>

                            <UniformGridLayout ItemsStretch="Uniform"
                                               MinColumnSpacing="4"
                                               MinRowSpacing="4" />

                        </ItemsView.Layout>

                    </ItemsView>

                </Grid>

            </SplitView.Content>

            <SplitView.Pane>

                <Grid Padding="36">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <RadioButtons HorizontalAlignment="Center"
                                  IsEnabled="{x:Bind viewModel.AreRadioButtonsEnabled, Mode=OneWay}"
                                  Margin="0,0,0,4"
                                  MaxColumns="2">

                        <RadioButtons.Items>

                            <RadioButton IsChecked="{x:Bind viewModel.ConvertToJXL, Mode=TwoWay}"
                                         x:Uid="ToJpegXL" />

                            <RadioButton x:Uid="FromJpegXL" />

                        </RadioButtons.Items>

                    </RadioButtons>

                    <Expander Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Margin="0,0,0,8">

                        <Expander.Content>

                            <TextBox Margin="16"
                                     x:Name="ArgumentsTextBox"
                                     Text="{x:Bind viewModel.Arguments, Mode=TwoWay}"
                                     x:Uid="ArgumentsTextBox" />

                        </Expander.Content>

                        <Expander.Header>

                            <StackPanel Orientation="Horizontal"
                                        Padding="12">

                                <FontIcon FontSize="24"
                                          Glyph="&#xE756;"
                                          Margin="0,0,16,0" />

                                <TextBlock VerticalAlignment="Center">

                                    <TextBlock.Inlines>

                                        <Run x:Uid="ExpertsSection1" />
                                        <LineBreak />
                                        <Run FontSize="12"
                                             FontWeight="Light"
                                             x:Uid="ExpertsSection2" />

                                    </TextBlock.Inlines>

                                </TextBlock>

                            </StackPanel>

                        </Expander.Header>

                    </Expander>

                    <Button Command="{x:Bind viewModel.FolderCommand}"
                            Grid.Row="2"
                            IsEnabled="{x:Bind viewModel.EnableAddButtons, Mode=OneWay}"
                            Margin="0,0,0,4"
                            x:Name="AddFolderButton"
                            Style="{StaticResource LocalButtonStyle}">

                        <Button.Content>

                            <StackPanel Orientation="Horizontal">

                                <FontIcon Glyph="&#xE8B7;"
                                          Margin="0,0,8,0" />
                                <TextBlock x:Uid="AddFolderButton" />

                            </StackPanel>

                        </Button.Content>

                    </Button>

                    <Button Command="{x:Bind viewModel.ImagesCommand}"
                            Grid.Column="2"
                            Grid.Row="3"
                            IsEnabled="{x:Bind viewModel.EnableAddButtons, Mode=OneWay}"
                            x:Name="AddImagesButton"
                            Style="{StaticResource LocalButtonStyle}">

                        <Button.Content>

                            <StackPanel Orientation="Horizontal">

                                <FontIcon Glyph="&#xE8B9;"
                                          Margin="0,0,8,0" />
                                <TextBlock x:Uid="ChooseImages" />

                            </StackPanel>

                        </Button.Content>

                    </Button>

                    <Button Command="{x:Bind viewModel.ConvertImagesCommand}"
                            Grid.Row="4"
                            Height="60"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind viewModel.EnableConvertButton, Mode=OneWay}"
                            Margin="0,8"
                            x:Name="ConvertButton">

                        <Button.Content>

                            <StackPanel Orientation="Horizontal">

                                <FontIcon Glyph="&#xE895;"
                                          Margin="0,0,8,0" />
                                <TextBlock x:Uid="ConvertButton" />

                            </StackPanel>

                        </Button.Content>

                    </Button>

                    <Button Command="{x:Bind viewModel.SaveImagesCommand}"
                            Grid.ColumnSpan="3"
                            Grid.Row="5"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind viewModel.EnableSaveButton, Mode=OneWay}"
                            Margin="0,0,0,4"
                            x:Name="SaveImagesButton">

                        <Button.Content>

                            <StackPanel Orientation="Horizontal">

                                <FontIcon Glyph="&#xE78C;"
                                          Margin="0,0,8,0" />
                                <TextBlock x:Uid="SaveImagesButton" />

                            </StackPanel>

                        </Button.Content>

                    </Button>

                    <Button Command="{x:Bind viewModel.ClearImagesCommand}"
                            Grid.Row="6"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind viewModel.EnableClearButton, Mode=OneWay}"
                            x:Name="ClearListButton">

                        <Button.Content>

                            <StackPanel Orientation="Horizontal">

                                <FontIcon Glyph="&#xE894;"
                                          Margin="0,0,8,0" />
                                <TextBlock x:Uid="ClearListButton" />

                            </StackPanel>

                        </Button.Content>

                    </Button>

                    <InfoBar Grid.Row="7"
                             IsClosable="False"
                             IsOpen="True"
                             Margin="-36"
                             Message="{x:Bind viewModel.InfobarMessage, Mode=OneWay}"
                             Title="{x:Bind viewModel.InfoBarTitle, Mode=OneWay}"
                             Severity="{x:Bind viewModel.Severity, Mode=OneWay}"
                             VerticalAlignment="Bottom">

                        <InfoBar.Content>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{x:Bind viewModel.ShowInfoBarContent, Mode=OneWay}">

                                <ProgressRing Height="24"
                                              IsActive="{x:Bind viewModel.IsConversionInProgress, Mode=OneWay}"
                                              Margin="0,0,8,0"
                                              x:Name="LoadingRing"
                                              Width="24" />

                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                                           Text="{x:Bind viewModel.ImagesCount, Mode=OneWay}" />

                            </StackPanel>

                        </InfoBar.Content>

                    </InfoBar>

                </Grid>

            </SplitView.Pane>

        </SplitView>



    </Grid>

</Page>