<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="JustExtraLight.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:applicationModel="using:Windows.ApplicationModel"
      xmlns:storage="using:Windows.Storage"
      xmlns:viewmodels="using:JustExtraLight.ViewModels"
      mc:Ignorable="d"
      Loaded="Page_Loaded">

    <Page.DataContext>

        <viewmodels:MainPageViewModel x:Name="viewModel" />

    </Page.DataContext>

    <Grid>

        <Grid.Background>

            <LinearGradientBrush EndPoint="0.5,1"
                                 StartPoint="0.5,0">

                <LinearGradientBrush.GradientStops>

                    <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}"
                                  Offset="0" />
                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}"
                                  Offset="0.7" />
                    <GradientStop Color="{ThemeResource SystemAccentColorLight3}"
                                  Offset="1" />

                </LinearGradientBrush.GradientStops>

            </LinearGradientBrush>

        </Grid.Background>

        <Grid.RowDefinitions>

            <RowDefinition Height="48" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <TitleBar Height="48"
                  x:Name="AppTitleBar"
                  Subtitle="BETA"
                  Title="Just eXtra Light">

            <TitleBar.IconSource>

                <ImageIconSource ImageSource="/Assets/Icons/JXLIco.ico" />

            </TitleBar.IconSource>

            <TitleBar.RightHeader>

                <Button Content="&#xE946;"
                        FontFamily="Segoe Fluent Icons">

                    <Button.Flyout>

                        <Flyout>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <Image Grid.Column="0"
                                       Grid.Row="0"
                                       Grid.RowSpan="2"
                                       Height="60"
                                       Margin="0,0,20,0"
                                       Width="60">

                                    <Image.Source>

                                        <BitmapImage DecodePixelHeight="60"
                                                     DecodePixelType="Logical"
                                                     DecodePixelWidth="60"
                                                     UriSource="/Assets/Icons/JXLIco.ico" />

                                    </Image.Source>

                                </Image>

                                <TextBlock Grid.Column="1"
                                           Grid.Row="0"
                                           Grid.RowSpan="2"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                            
                            <Run FontWeight="SemiBold"
                                    x:Name="AppVersionRun" />
                            
                            <LineBreak />
                            
                            <Run x:Uid="AppMadeWith" />
                            
                            <Hyperlink NavigateUri="https://github.com/libjxl/libjxl">
                                
                                <Hyperlink.Inlines>
                                    
                                    <Run Text="libjxl" />
                                    
                                </Hyperlink.Inlines>
                                
                            </Hyperlink>
                            
                            <Run FontSize="12"
                                    Text="(ver 0.12.0)" />

                                </TextBlock>

                            </Grid>

                        </Flyout>

                    </Button.Flyout>

                </Button>

            </TitleBar.RightHeader>

        </TitleBar>

        <Grid CornerRadius="{StaticResource ControlCornerRadius}"
              Grid.Row="1"
              Margin="36">

            <Grid.Resources>

                <Style BasedOn="{StaticResource AccentButtonStyle}"
                       x:Key="LocalButtonStyle"
                       TargetType="Button">

                    <Setter Property="Height"
                            Value="50" />
                    <Setter Property="HorizontalAlignment"
                            Value="Stretch" />

                </Style>

            </Grid.Resources>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>

            <RadioButtons IsEnabled="{x:Bind viewModel.AreRadioButtonsEnabled, Mode=OneWay}"
                          MaxColumns="2">

                <RadioButtons.Header>

                    <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                               x:Uid="RadioButtonsHeader" />

                </RadioButtons.Header>

                <RadioButtons.Items>

                    <RadioButton IsChecked="{x:Bind viewModel.ConvertToJXL, Mode=TwoWay}"
                                 x:Uid="ToJpegXl" />

                    <RadioButton x:Uid="ToJpeg" />

                </RadioButtons.Items>

            </RadioButtons>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right">

                <Button Command="{x:Bind viewModel.FolderCommand}"
                        CornerRadius="4,4,0,0"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind viewModel.EnableAddButtons, Mode=OneWay}"
                        x:Name="AddFolderButton">

                    <Button.Content>

                        <StackPanel Orientation="Horizontal">

                            <FontIcon Glyph="&#xE8B7;"
                                      Margin="0,0,8,0" />
                            <TextBlock x:Uid="AddFolderButton" />

                        </StackPanel>

                    </Button.Content>

                </Button>

                <Button Command="{x:Bind viewModel.ImagesCommand}"
                        CornerRadius="0,0,4,4"
                        Grid.Column="1"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind viewModel.EnableAddButtons, Mode=OneWay}"
                        x:Name="AddImagesButton">

                    <Button.Content>

                        <StackPanel Orientation="Horizontal">

                            <FontIcon Glyph="&#xE8B9;"
                                      Margin="0,0,8,0" />
                            <TextBlock x:Uid="ChooseImages" />

                        </StackPanel>

                    </Button.Content>

                </Button>

            </StackPanel>

            <Expander Grid.ColumnSpan="2"
                      Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Margin="0,0,0,8">

                <Expander.Content>

                    <TextBox Margin="16"
                             x:Name="ArgumentsTextBox"
                             Text="{x:Bind viewModel.Arguments, Mode=TwoWay}"
                             x:Uid="ArgumentsTextBox" />

                </Expander.Content>

                <Expander.Header>

                    <StackPanel Orientation="Horizontal"
                                Padding="12">

                        <FontIcon FontSize="24"
                                  Glyph="&#xE756;"
                                  Margin="0,0,16,0" />

                        <TextBlock VerticalAlignment="Center">

                            <TextBlock.Inlines>

                                <Run x:Uid="ExpertsSection1" />
                                <LineBreak />
                                <Run FontSize="12"
                                     FontWeight="Light"
                                     x:Uid="ExpertsSection2" />

                            </TextBlock.Inlines>

                        </TextBlock>

                    </StackPanel>

                </Expander.Header>

            </Expander>

            <Button Command="{x:Bind viewModel.ConvertImagesCommand}"
                    Grid.Row="2"
                    IsEnabled="{x:Bind viewModel.EnableConvertButton, Mode=OneWay}"
                    x:Name="ConvertButton"
                    Style="{ThemeResource AccentButtonStyle}">

                <Button.Content>

                    <StackPanel Orientation="Horizontal">

                        <FontIcon Glyph="&#xE895;"
                                  Margin="0,0,8,0" />
                        <TextBlock x:Uid="ConvertButton" />

                    </StackPanel>

                </Button.Content>

            </Button>

            <StackPanel Grid.Column="1"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">

                <Button CornerRadius="4,0,0,4"
                        Command="{x:Bind viewModel.SaveImagesCommand}"
                        IsEnabled="{x:Bind viewModel.EnableSaveButton, Mode=OneWay}"
                        x:Name="SaveImagesButton">

                    <Button.Content>

                        <StackPanel Orientation="Horizontal">

                            <FontIcon Glyph="&#xE78C;"
                                      Margin="0,0,8,0" />
                            <TextBlock x:Uid="SaveImagesButton" />

                        </StackPanel>

                    </Button.Content>

                </Button>

                <Button Command="{x:Bind viewModel.ClearImagesCommand}"
                        CornerRadius="0,4,4,0"
                        IsEnabled="{x:Bind viewModel.EnableClearButton, Mode=OneWay}"
                        x:Name="ClearListButton">

                    <Button.Content>

                        <StackPanel Orientation="Horizontal">

                            <FontIcon Glyph="&#xE894;"
                                      Margin="0,0,8,0" />
                            <TextBlock x:Uid="ClearListButton" />

                        </StackPanel>

                    </Button.Content>

                </Button>

            </StackPanel>

            <TextBlock Canvas.ZIndex="1"
                       Grid.ColumnSpan="2"
                       Grid.Row="3"
                       HorizontalAlignment="Center"
                       x:Name="DragAndDropText"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextAlignment="Center"
                       x:Uid="DragAndDropInstructions"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind viewModel.ShowListText, Mode=OneWay}" />

            <ItemsView AllowDrop="True"
                       Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                       BorderThickness="0"
                       CornerRadius="4,4,0,0"
                       DragOver="{x:Bind viewModel.ImageItemsView_DragOver}"
                       Drop="{x:Bind viewModel.ImageItemsView_Drop}"
                       Grid.ColumnSpan="2"
                       Grid.Row="3"
                       ItemsSource="{x:Bind viewModel.ImagesList}"
                       Margin="0,4,0,0"
                       x:Name="ImageItemsView"
                       SelectionMode="None">

                <ItemsView.ItemTemplate>

                    <DataTemplate x:DataType="viewmodels:ImageInfoViewModel">

                        <ItemContainer ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay, TargetNullValue=}">

                            <Grid Background="{x:Bind BorderColor, Mode=OneWay}"
                                  CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />

                                </Grid.RowDefinitions>

                                <Border CornerRadius="{StaticResource ControlCornerRadius}"
                                        Height="100"
                                        Margin="0,4,0,0"
                                        Width="100">

                                    <Border.Background>

                                        <ImageBrush>

                                            <ImageBrush.ImageSource>

                                                <BitmapImage DecodePixelHeight="100"
                                                             DecodePixelType="Logical"
                                                             DecodePixelWidth="100"
                                                             UriSource="{x:Bind TemporaryPath}" />

                                            </ImageBrush.ImageSource>

                                        </ImageBrush>

                                    </Border.Background>

                                </Border>

                                <FontIcon Grid.Row="1"
                                          FontSize="16"
                                          Foreground="White"
                                          Glyph="{x:Bind Icon, Mode=OneWay}"
                                          HorizontalAlignment="Right"
                                          x:Load="{x:Bind IsConversionCompleted, Mode=OneWay}"
                                          x:Name="SuccessfulBorder"
                                          VerticalAlignment="Bottom" />

                            </Grid>

                        </ItemContainer>

                    </DataTemplate>

                </ItemsView.ItemTemplate>

                <ItemsView.Layout>

                    <UniformGridLayout ItemsStretch="Uniform"
                                       MinColumnSpacing="4"
                                       MinRowSpacing="4" />

                </ItemsView.Layout>

            </ItemsView>

            <InfoBar BorderThickness="0"
                     CornerRadius="0,0,4,4"
                     Grid.ColumnSpan="2"
                     Grid.Row="4"
                     IsClosable="False"
                     IsOpen="True"
                     Margin="0,4,0,0"
                     Message="{x:Bind viewModel.InfobarMessage, Mode=OneWay}"
                     Title="{x:Bind viewModel.InfoBarTitle, Mode=OneWay}"
                     Severity="{x:Bind viewModel.Severity, Mode=OneWay}"
                     VerticalAlignment="Bottom">

                <InfoBar.Content>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{x:Bind viewModel.ShowInfoBarContent, Mode=OneWay}">

                        <ProgressRing Height="24"
                                      IsActive="{x:Bind viewModel.IsConversionInProgress, Mode=OneWay}"
                                      x:Name="LoadingRing"
                                      Width="24" />

                        <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                                   Text="{x:Bind viewModel.ImagesCount, Mode=OneWay}" />

                    </StackPanel>

                </InfoBar.Content>

            </InfoBar>

        </Grid>

    </Grid>

</Page>